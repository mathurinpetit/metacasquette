{% extends 'base.html.twig' %}
{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('/build/game/game-app.css') }}?v=20260906-creation-limit-1">
{% endblock %}

{% block body %}
  <div
    id="metacasquette-game-app"
    data-game-id="{{ gameId }}"
    data-upload-url="{{ path('jeuRecordings', { id: gameId }) }}"
    data-french-flag="{{ asset('/img/fr.png') }}"
    data-english-flag="{{ asset('/img/en.png') }}"
    data-instagram-url="{{ instagram }}"
  ></div>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
  <script type="module" src="{{ asset('/build/game/game-app.js') }}?v=20260906-creation-limit-1"></script>
{% endblock %}
