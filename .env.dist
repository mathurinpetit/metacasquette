# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me
###< symfony/framework-bundle ###

###> database ###
DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=5.7
###< database ###

###> symfony/swiftmailer-bundle ###
MAILER_URL=null://localhost
###< symfony/swiftmailer-bundle ###

APP_TELEPHONE=06 45 38 10 87
APP_EMAIL=contact@metacasquette.com
APP_FACEBOOK=
APP_INSTAGRAM=https://www.instagram.com/meta_casquette/
APP_YTID=
APP_PATHFILES=/var/www/metacasquette/data
APP_GAMEURL=/
APP_OPENAIKEY=
APP_GOOGLEAPIFILE=
METACASQUETTE_GOOGLE_TTS_VOICE_FR=fr-FR-Neural2-D
METACASQUETTE_GOOGLE_TTS_VOICE_EN=en-US-Neural2-D

# Direct Instagram publication (configure secrets in .env.local)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_PUBLISH_ENABLED=0
